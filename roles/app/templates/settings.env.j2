CHAT_ADDR=127.0.0.1:8090
CHAT_BLOB_DIR=/var/lib/loamz-chat/blobs
# The most the encrypted files may take in all. Free storage has a ceiling; past it the provider bills, so we stop first.
CHAT_BLOB_BUDGET_MB={{ blob_budget_mb | default(20000) }}
# Everyone signs in through Keycloak: the address people see, and the keys fetched over the machine's own network.
CHAT_OIDC_ISSUER=https://{{ auth_domain }}/realms/loamz
CHAT_OIDC_JWKS_URL=http://127.0.0.1:8081/realms/loamz/protocol/openid-connect/certs
CHAT_PUBLIC_URL=https://{{ domain }}
CHAT_PUSH_CONTACT=mailto:{{ acme_email | default('admin@' ~ domain, true) }}
# "approval": a new person says why they want to use it and a founder approves. "open": anyone who signs in is let in.
CHAT_ACCESS={{ access | default('approval') }}
# Emails approved on sight, who may approve others.
CHAT_FOUNDERS={{ founders | default('') }}
{% if smtp_host %}
CHAT_SMTP_URL={{ 'smtps' if smtp_port | string == '465' else 'smtp' }}://{{ smtp_user | urlencode }}:{{ smtp_password | urlencode }}@{{ smtp_host }}:{{ smtp_port }}
CHAT_MAIL_FROM=Loamz Chat <{{ smtp_from }}>
{% endif %}
RUST_LOG=info
