CHAT_ADDR=127.0.0.1:8090
CHAT_BLOB_DIR=/var/lib/loamz-chat/blobs
CHAT_COOKIE_SECURE=true
CHAT_SMS_COUNTRIES={{ sms_countries }}
{% if oidc_issuer %}
CHAT_OIDC_ISSUER={{ oidc_issuer }}
CHAT_OIDC_JWKS_URL={{ oidc_jwks_url }}
{% endif %}
CHAT_PUSH_CONTACT=mailto:{{ acme_email | default('admin@' ~ domain, true) }}
RUST_LOG=info
# "approval": a new person says why they want to use it and a founder approves. "open": anyone who can sign in is let in.
CHAT_ACCESS={{ access | default('approval') }}
CHAT_FOUNDERS={{ founders | default('') }}
