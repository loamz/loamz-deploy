# Written by Ansible from products/{{ product_id }}.yml and group_vars product_env.{{ product_id }}. Do not edit by hand.
{% if product.deploy.database | default(false) %}
{{ product.deploy.database_env }}=postgres://loamz_{{ product_id }}:{{ product_db_password.content | b64decode | trim }}@127.0.0.1/loamz_{{ product_id }}
{% endif %}
{% if product.deploy.web | default(false) %}
LOAMZ_{{ product_id | upper }}_WEB_DIR={{ product_dir }}/web
{% endif %}
{% for name, value in (product_env | default({})).get(product_id, {}).items() %}
{{ name }}={{ value }}
{% endfor %}
