{
  "realm": "loamz",
  "displayName": "Loamz",
  "loginTheme": "loamz",
  "enabled": true,
  "sslRequired": "{{ 'none' if dev | default(false) else 'external' }}",
  "organizationsEnabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "verifyEmail": true,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 2592000,
  "ssoSessionMaxLifespan": 7776000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "eventsEnabled": true,
  "adminEventsEnabled": true,
{% if smtp_host %}
  "smtpServer": {
    "host": "{{ smtp_host }}",
    "port": "{{ smtp_port }}",
    "from": "{{ smtp_from }}",
    "fromDisplayName": "Loamz",
    "auth": "{{ 'true' if smtp_user else 'false' }}",
    "user": "{{ smtp_user }}",
    "password": "${SMTP_PASSWORD}",
    "ssl": "{{ 'true' if smtp_port | string == '465' else 'false' }}",
    "starttls": "{{ 'true' if smtp_port | string in ['587', '2525'] else 'false' }}"
  },
{% endif %}
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "config": { "kc.user.profile.config": ["{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"}],\"unmanagedAttributePolicy\":\"ENABLED\"}"] }
      }
    ]
  },
  "clients": [
    {
      "clientId": "loamz-chat",
      "name": "Loamz Chat",
      "description": "The chat web app: public client, authorization code + PKCE (S256).",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "rootUrl": "{{ scheme | default('https') }}://{{ domain }}",
      "redirectUris": ["{{ scheme | default('https') }}://{{ domain }}/auth/callback"],
      "webOrigins": ["{{ scheme | default('https') }}://{{ domain }}"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "{{ scheme | default('https') }}://{{ domain }}/*"
      },
      "protocolMappers": [
        {
          "name": "picture",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "picture",
            "claim.name": "picture",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "loamz-chat audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "loamz-chat",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": ["basic", "web-origins", "acr", "profile", "roles", "email", "organization"],
      "optionalClientScopes": []
    },
    {
      "clientId": "loamz-data",
      "name": "Loamz Data",
      "description": "The Data web app and API: public client, authorization code + PKCE (S256). Tokens carry the organization (its alias, which Keycloak never lets anyone change), the person's groups, and the client role account-admin.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "rootUrl": "{{ scheme | default('https') }}://{{ data_domain | default('data.loamz.com') }}",
      "redirectUris": ["{{ scheme | default('https') }}://{{ data_domain | default('data.loamz.com') }}/*"],
      "webOrigins": ["{{ scheme | default('https') }}://{{ data_domain | default('data.loamz.com') }}"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "{{ scheme | default('https') }}://{{ data_domain | default('data.loamz.com') }}/*"
      },
      "protocolMappers": [
        {
          "name": "loamz-data audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": { "included.client.audience": "loamz-data", "id.token.claim": "false", "access.token.claim": "true", "introspection.token.claim": "true" }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": { "claim.name": "groups", "full.path": "true", "id.token.claim": "true", "access.token.claim": "true", "userinfo.token.claim": "true" }
        }
      ],
      "defaultClientScopes": ["basic", "web-origins", "acr", "profile", "roles", "email", "organization"],
      "optionalClientScopes": []
    },
    {
      "clientId": "loamz-data-directory",
      "name": "Loamz Data directory",
      "description": "Lets Data list people and groups for its admin pages. A service account that can only read users and groups.",
      "enabled": true,
      "publicClient": false,
      "secret": "${LOAMZ_DATA_DIRECTORY_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": ["basic"],
      "optionalClientScopes": []
    },
    {
      "clientId": "loamz-agents",
      "name": "Loamz Agents",
      "description": "The agents server acting for a person: it exchanges the person's token (RFC 8693, standard token exchange) for one for loamz-data, and keeps its own service account for data no single person owns. A person's token must name this client in its audience to be exchanged.",
      "enabled": true,
      "publicClient": false,
      "secret": "${LOAMZ_AGENTS_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "attributes": { "standard.token.exchange.enabled": "true" },
      "protocolMappers": [
        {
          "name": "loamz-data audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": { "included.client.audience": "loamz-data", "id.token.claim": "false", "access.token.claim": "true", "introspection.token.claim": "true" }
        }
      ],
      "defaultClientScopes": ["basic", "roles", "organization"],
      "optionalClientScopes": []
    }{% if dev | default(false) %},
    {
      "clientId": "loamz-data-test",
      "name": "Loamz Data test (development only)",
      "description": "Lets test scripts get real tokens for test users with a password. Exists only in the throwaway development realm.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocolMappers": [
        { "name": "loamz-data audience", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper", "consentRequired": false,
          "config": { "included.client.audience": "loamz-data", "id.token.claim": "false", "access.token.claim": "true", "introspection.token.claim": "true" } },
        { "name": "loamz-agents audience", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper", "consentRequired": false,
          "config": { "included.client.audience": "loamz-agents", "id.token.claim": "false", "access.token.claim": "true", "introspection.token.claim": "true" } },
        { "name": "groups", "protocol": "openid-connect", "protocolMapper": "oidc-group-membership-mapper", "consentRequired": false,
          "config": { "claim.name": "groups", "full.path": "true", "id.token.claim": "true", "access.token.claim": "true", "userinfo.token.claim": "true" } }
      ],
      "defaultClientScopes": ["basic", "profile", "roles", "email", "organization"],
      "optionalClientScopes": []
    }{% endif %}
  ],
  "roles": {
    "client": {
      "loamz-data": [
        { "name": "account-admin", "description": "May manage this account in Loamz Data: workspaces, identities, catalogs, compute, usage." }
      ]
    }
  },
  "users": [
    {
      "username": "service-account-loamz-data-directory",
      "enabled": true,
      "serviceAccountClientId": "loamz-data-directory",
      "clientRoles": { "realm-management": ["view-users", "query-users", "query-groups", "view-realm"] }
    }
  ],
{% if dev | default(false) %}
  "identityProviders": []
{% else %}
  "identityProviderMappers": [
    {
      "name": "google picture",
      "identityProviderAlias": "google",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": { "syncMode": "FORCE", "claim": "picture", "user.attribute": "picture" }
    }
  ],
  "identityProviders": [
    {
      "alias": "google",
      "displayName": "Google",
      "providerId": "google",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "${GOOGLE_CLIENT_ID}",
        "clientSecret": "${GOOGLE_CLIENT_SECRET}",
        "defaultScope": "openid profile email",
        "syncMode": "IMPORT"
      }
    }
  ]
{% endif %}
}
