LOAMZ_AGENTS_DATABASE__URL=postgresql://loamz_agents:{{ agents_db_password.content | b64decode | trim }}@127.0.0.1:5432/loamz_agents
LOAMZ_AGENTS_OIDC__ISSUER=https://{{ auth_domain }}/realms/loamz
LOAMZ_AGENTS_OIDC__AUDIENCE=loamz-agents
LOAMZ_AGENTS_OIDC__PERSONAL_TENANT=personal
LOAMZ_AGENTS_LLM__MODEL={{ agents_model | default('openai/gpt-5.4-mini') }}
LOAMZ_AGENTS_LLM__OPENAI_API_KEY={{ openai_api_key }}
LOAMZ_AGENTS_SEALING__KEYS__K1={{ agents_sealing.content | b64decode | trim }}
LOAMZ_AGENTS_SEALING__PRIMARY=K1
LOAMZ_SERVE_ROLES=all
# Connector sign-in (Notion, Todoist, Linear, ...): vendors send the person back here, and read our client id document from here.
LOAMZ_AGENTS_HTTP__PUBLIC_URL=https://{{ domain }}/agents-api
LOAMZ_AGENTS_HTTP__FRONTEND_URL=https://{{ domain }}
