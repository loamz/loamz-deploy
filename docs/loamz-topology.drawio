 session)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="242" y="962" width="226" height="26" as="geometry"/></mxCell><mxCell id="c50" value="Read from config, never tested" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="242" y="992" width="226" height="26" as="geometry"/></mxCell><mxCell id="c51" value="Not deployed / old" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#666666;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="242" y="1022" width="226" height="26" as="geometry"/></mxCell><mxCell id="c52" value="Someone else's service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="242" y="1052" width="226" height="26" as="geometry"/></mxCell><mxCell id="c53" value="People" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="242" y="1082" width="226" height="26" as="geometry"/></mxCell><mxCell id="c54" value="Plaintext or risk" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="242" y="1112" width="226" height="26" as="geometry"/></mxCell><mxCell id="c55" value="To check: Is B2 actually configured (the backup only goes off the machine if a B2 key is set)? Has a restore ever been tested? The agents' own files and blobs over 10 MB are not in the off-site copy. One VM = one point of failure, and nothing alerts you if it goes down." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="230" y="820" width="920" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="3 · Who can read what"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Trust boundaries: where the text is scrambled, and where it is not" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="5" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="A. Chat between people: end-to-end encrypted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#888888;dashed=1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="1500" height="190" as="geometry"/></mxCell><mxCell id="c4" value="Sender's device&lt;br&gt;web app + WASM (OpenMLS)&lt;br&gt;keys in the vault (non-extractable key)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="280" height="100" as="geometry"/></mxCell><mxCell id="c5" value="Internet&lt;br&gt;TLS via Caddy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="120" width="180" height="60" as="geometry"/></mxCell><mxCell id="c6" value="chat-server&lt;br&gt;stores ciphertext, orders the log&lt;br&gt;sees: who, when, size, IP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="100" width="300" height="100" as="geometry"/></mxCell><mxCell id="c7" value="Recipient's device(s)&lt;br&gt;each has its own keys&lt;br&gt;decrypts, keeps messages in its vault" style="rounded=1;whiteSpace=wrap;html=