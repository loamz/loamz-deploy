d4;strokeColor=#82b366;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="310" width="280" height="90" as="geometry"/></mxCell><mxCell id="c15" value="Agents server&lt;br&gt;stores the conversation (sealed at rest? check)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="310" width="280" height="90" as="geometry"/></mxCell><mxCell id="c16" value="OpenAI&lt;br&gt;receives the text to answer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1260" y="320" width="220" height="70" as="geometry"/></mxCell><mxCell id="c17" value="ciphertext" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#2e7d32;strokeWidth=2;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="ciphertext" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#2e7d32;strokeWidth=2;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="PLAINTEXT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#b85450;strokeWidth=2;dashed=1;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="PLAINTEXT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#b85450;strokeWidth=2;dashed=1;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="C. Backup: only the person's secret opens it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#888888;dashed=1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="520" width="1500" height="190" as="geometry"/></mxCell><mxCell id="c22" value="Device vault&lt;br&gt;messages + recovery code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="240" height="80" as="geometry"/></mxCell><mxCell id="c23" value="Seal on the device&lt;br&gt;PBKDF2 600k + AES-GCM&lt;br&gt;with the recovery code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="570" width="260" height="100" as="geometry"/></mxCell><mxCell id="c24" value="Google Drive: hidden app folder&lt;br&gt;only the sealed file" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="580" width="260" height="80" as="geometry"/></mxCell><mxCell id="c25" value="New phone&lt;br&gt;sign in to Drive + type the code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="980" y="580" width="260" height="80" as="geometry"/></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#555555;" edge="1" parent="1" source="c22" target="c23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="straight from the device, never through us" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#2e7d32;strokeWidth=2;" edge="1" parent="1" source="c23" target="c24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#555555;" edge="1" parent="1" source="c24" target="c25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="D. Wake-up when the app is closed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#888888;dashed=1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="740" width="1500" height="150" as="geometry"/></mxCell><mxCell id="c30" value="chat-server" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="790" width="200" height="60" as="geometry"/></mxCell><mxCell id="c31" value="Browser push service&lt;br&gt;Google · Apple · Mozilla" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="790" width="280" height="60" as="geometry"/></mxCell><mxCell id="c32" value="Service worker on the device&lt;br&gt;shows 'You have a new message'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="790" width="300" height="60" as="geometry"/></mxCell><mxCell id="c33" value="empty message, no text" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#6c8ebf;dashed=1;" edge="1" parent="1" source="c30" target="c31"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#555555;" edge="1" parent="1" source="c31" target="c32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c35" value="Questions: (1) What exactly is 'sealed' in the agents server at rest (K1 key)? (2) In a group, once an agent is added, every member's text goes to OpenAI: is that clear enough on screen? (3) Stories: the 'seen by' list and story photos stay inside ciphertext, right?" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1060" y="730" width="440" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p4" name="4 · Sign-in and access"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="How a person gets in, and how they get out again" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="5" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Person" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="200" width="160" height="60" as="geometry"/></mxCell><mxCell id="c4" value="Home page /&lt;br&gt;then Log in at /login&lt;br&gt;tick: 18 or older + Terms + Privacy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="180" width="240" height="100" as="geometry"/></mxCell><mxCell id="c5" value="Keycloak (auth.loamz.com)&lt;br&gt;OIDC code flow + PKCE&lt;br&gt;realm 'loamz'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="180" width="240" height="100" as="geometry"/></mxCell><mxCell id="c6" value="Google&lt;br&gt;'Continue with Google'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="840" y="100" width="200" height="60" as="geometry"/></mxCell><mxCell id="c7" value="Company sign-in&lt;br&gt;'work email' (their own IdP)" style="rou